# ─── Claude ───────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
EXTRACTION_MODEL=claude-opus-4-20250514

# ─── Confidence ───────────────────────────────────────────────────────────────
# Field-level confidence threshold for AUTO vs REVIEW routing
CONFIDENCE_THRESHOLD=0.85
# Customer identification confidence threshold (separate, lower)
CUSTOMER_ID_THRESHOLD=0.80

# ─── SharePoint / MS Graph ────────────────────────────────────────────────────
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
# Single folder path to watch (e.g. customers/incoming)
WATCH_FOLDER=customers/incoming
# Poll interval in seconds
POLL_INTERVAL_SECONDS=60

# ─── Business Central ────────────────────────────────────────────────────────
BC_BASE_URL=https://api.businesscentral.dynamics.com/v2.0/<tenant>/<environment>
BC_COMPANY_ID=
BC_API_KEY=

# ─── Email (SMTP) ────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=noreply@acornic.co.uk
MAIL_TEAM=sales-orders@acornic.co.uk

# ─── Webhook / Review ────────────────────────────────────────────────────────
APP_BASE_URL=https://your-domain.com/pdf-order-intelligence
WEBHOOK_PORT=3100
WEBHOOK_SECRET=change-this-to-a-random-string
REVIEW_TIMEOUT_MINUTES=240
REVIEW_ESCALATION_EMAIL=manager@acornic.co.uk
